# Private SSH key
gift-app-key.pem
*.pem

# Terraform working directories (providers, modules)
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan

# Local Terraform variables (may contain secrets)
**/terraform.tfvars
**/terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log
